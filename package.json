{
  "name": "shopify-theme-locale-validator",
  "version": "1.0.0",
  "description": "Validates Shopify theme locale JSON files: missing/extra translation keys, broken pluralization groups, mismatched {{ placeholders }}, duplicate JSON keys, and keys referenced in Liquid that don't exist.",
