<div class="hero">
  {%- if section.settings.heading != blank -%}
    <h1>{{ section.settings.heading }}</h1>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "t:sections.hero.name",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.hero.settings.heading.label"
    }
  ],
  "presets": [
    {
      "name": "t:sections.hero.name"
    }
  ]
}
{% endschema %}
